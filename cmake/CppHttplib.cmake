set(LOCAL_AGENT_HTTPLIB_SHA256 "7d3f813d05dad23b9c66eb6d9c1ff3d66f6acfaf6e5900ce960f7990e78079ea")
set(LOCAL_AGENT_HTTPLIB_DIR "${CMAKE_BINARY_DIR}/deps")
file(MAKE_DIRECTORY "${LOCAL_AGENT_HTTPLIB_DIR}")
set(LOCAL_AGENT_HTTPLIB_HEADER "${LOCAL_AGENT_HTTPLIB_DIR}/httplib.h")
if(NOT EXISTS "${LOCAL_AGENT_HTTPLIB_HEADER}")
    file(DOWNLOAD "https://raw.githubusercontent.com/yhirose/cpp-httplib/v0.20.1/httplib.h"
        "${LOCAL_AGENT_HTTPLIB_HEADER}" TLS_VERIFY ON TIMEOUT 60
        EXPECTED_HASH "SHA256=${LOCAL_AGENT_HTTPLIB_SHA256}")
endif()
file(SHA256 "${LOCAL_AGENT_HTTPLIB_HEADER}" LOCAL_AGENT_HTTPLIB_ACTUAL_HASH)
if(NOT LOCAL_AGENT_HTTPLIB_ACTUAL_HASH STREQUAL LOCAL_AGENT_HTTPLIB_SHA256)
    message(FATAL_ERROR "Unexpected cpp-httplib header hash in ${LOCAL_AGENT_HTTPLIB_HEADER}")
endif()
